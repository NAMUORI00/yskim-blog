---
// Optional in-article AdSense unit. Renders nothing unless adsensePublisherId
// is set in src/config.ts. The global auto-ads loader in Base.astro covers most
// cases; use this component in a layout when you want a fixed slot.
//   <AdSlot slot="1234567890" />
import { SITE } from "../config";
interface Props {
  slot: string;
  format?: string;
}
const { slot, format = "auto" } = Astro.props;
const client = SITE.adsensePublisherId;
---

{client && (
  <div class="ad-slot" aria-label="광고">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
