---
// Affiliate disclosure box. Shown automatically on posts tagged with an
// affiliate tag (see posts/[slug].astro), so it can be controlled entirely
// from Notion by tagging a post. The .affiliate-disclosure styles live in
// static/css/site.css.
interface Props {
  message?: string;
}
const defaultMessage =
  "이 포스팅에는 제휴(affiliate) 링크가 포함되어 있으며, 이를 통해 구매가 발생하면 운영자가 일정액의 수수료를 받을 수 있습니다. 이는 독자에게 추가 비용을 발생시키지 않습니다.";
const { message = defaultMessage } = Astro.props;
---

<aside class="affiliate-disclosure" role="note">
  <strong>제휴 고지</strong>
  <p>{message}</p>
</aside>
