---
import { SITE, UI } from "../config";
import { getPublishedPosts, postUrl, tagUrl, slugifyTerm } from "../lib/posts";

type Node = { id: string; label: string; type: string; url: string };
type Link = { source: string; target: string };

const nodes: Node[] = [];
const links: Link[] = [];
const seen = new Set<string>();
const addNode = (n: Node) => {
  if (!seen.has(n.id)) {
    seen.add(n.id);
    nodes.push(n);
  }
};

const allPosts = await getPublishedPosts();
const match = Astro.url.pathname.match(/^\/posts\/([^/]+)\/?$/);
const current = match
  ? allPosts.find((p) => p.data.slug === decodeURIComponent(match[1]))
  : undefined;

if (current) {
  const mainId = `post:${current.data.slug}`;
  addNode({ id: mainId, label: current.data.title, type: "main", url: postUrl(current.data.slug) });
  for (const tag of current.data.tags) {
    const tagId = `tag:${slugifyTerm(tag)}`;
    addNode({ id: tagId, label: tag, type: "tag", url: tagUrl(tag) });
    links.push({ source: mainId, target: tagId });
  }
} else {
  const rootId = `profile:${slugifyTerm(SITE.handle)}`;
  addNode({ id: rootId, label: SITE.handle, type: "main", url: "/" });
  for (const post of allPosts.slice(0, 6)) {
    const postId = `post:${post.data.slug}`;
    addNode({ id: postId, label: post.data.title, type: "post", url: postUrl(post.data.slug) });
    links.push({ source: rootId, target: postId });
    for (const tag of post.data.tags) {
      const tagId = `tag:${slugifyTerm(tag)}`;
      addNode({ id: tagId, label: tag, type: "tag", url: tagUrl(tag) });
      links.push({ source: postId, target: tagId });
    }
  }
}

const graph = JSON.stringify({ nodes, links });
const hasGraph = nodes.length > 1;
---

{hasGraph && (
  <section class="sidebar-card sidebar-graph-card">
    <p class="sidebar-title">지식 그래프</p>
    <div class="sidebar-graph-canvas" data-knowledge-graph>
      <template class="knowledge-graph-data">{graph}</template>
      <canvas class="knowledge-graph-canvas" aria-hidden="true"></canvas>
    </div>
  </section>
  <script src="/js/knowledge-graph.js" is:inline defer></script>
)}
