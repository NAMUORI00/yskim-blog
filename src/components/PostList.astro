---
import PostCard from "./PostCard.astro";
import { UI } from "../config";
import type { PostListItem } from "../lib/posts";

interface Props {
  posts: PostListItem[];
  level?: 2 | 3;
  emptyText?: string;
}

const { posts, level = 2, emptyText = UI.noPostsYet } = Astro.props;
---

{posts.length > 0 ? (
  <div class="post-list">
    {posts.map((post) => <PostCard post={post} level={level} />)}
  </div>
) : (
  <p class="empty-state">{emptyText}</p>
)}
