---
import { getCollection } from "astro:content";
import { SITE, UI } from "../config";
import { getTaxonomy } from "../lib/posts";
import { getSiteProfile } from "../lib/profile";

const profile = await getSiteProfile();
const taxonomy = await getTaxonomy();
const pages = await getCollection("pages", (page) => !page.data.draft);
const about = pages.find((page) => page.data.slug === "about");
const path = decodeURI(Astro.url.pathname);
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const nav = [
  { href: "/", label: UI.navHome, icon: "home", active: path === "/" },
  { href: "/posts/", label: UI.allPosts, icon: "list", active: path === "/posts/" || path.startsWith("/posts/page/"), count: taxonomy.posts.length },
  ...(about ? [{ href: "/pages/about/", label: about.data.title || UI.navAbout, icon: "user", active: path === "/pages/about/" }] : []),
  { href: "/search/", label: UI.navSearch, icon: "search", active: path.startsWith("/search/") },
];
const categories = taxonomy.categories.filter((category) => category.url);
const searchIndex = JSON.stringify(
  taxonomy.posts.map((post) => ({
    title: post.title,
    summary: post.summary,
    category: taxonomy.categoryById.get(post.categoryIds[0])?.label ?? "",
    tags: post.tagIds.map((id) => taxonomy.tagById.get(id)?.label ?? id),
    url: post.url,
  })),
);
---

<aside id="profile-rail" class="profile-rail" aria-label="프로필과 탐색" data-drawer>
  <div class="profile-rail__inner">
    <section class="rail-identity" aria-label="프로필">
      <a class="rail-avatar" href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={`${profile.name} 프로필`}>
        <img src={profile.avatar} alt="" width="80" height="80" decoding="async" />
      </a>
      <a class="rail-brand" href="/">{SITE.title}</a>
      <p class="rail-handle">{profile.name} (@{profile.handle})</p>
      {profile.bio && <p class="rail-bio">{profile.bio}</p>}
      {profile.address && (
        <p class="rail-place"><span class="rail-place__dot" aria-hidden="true"></span>{profile.address}</p>
      )}
    </section>

    <div class="rail-search" data-rail-search>
      <form class="rail-search__form" action="/search/" role="search">
        <label class="sr-only" for="rail-search-input">{UI.navSearch}</label>
        <svg class="rail-search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg>
        <input id="rail-search-input" type="search" name="q" inputmode="search" autocomplete="off" placeholder="블로그 검색" data-rail-search-input />
      </form>
      <div class="rail-search__results" hidden data-rail-search-results></div>
      <template data-rail-search-index>{searchIndex}</template>
    </div>

    <nav class="rail-nav" aria-label="주요 메뉴">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} class={item.active ? "is-active" : undefined} aria-current={item.active ? "page" : undefined}>
              <span class="rail-nav__line" aria-hidden="true"></span>
              <svg class="rail-nav__icon" viewBox="0 0 24 24" aria-hidden="true">
                {item.icon === "home" && <path d="M4 11 12 4l8 7M6 9.5V20h12V9.5" />}
                {item.icon === "list" && <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" />}
                {item.icon === "user" && <><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /></>}
                {item.icon === "search" && <><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></>}
              </svg>
              <span class="rail-nav__label">{item.label}</span>
              {typeof item.count === "number" && <span class="rail-count">{item.count}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="rail-section" aria-labelledby="rail-categories-title">
      <h2 id="rail-categories-title" class="rail-section-title">{UI.categories}</h2>
      {categories.length > 0 ? (
        <ul class="rail-category-list">
          {categories.map((category) => {
            const active = isActive(category.url!);
            return (
              <li>
                <a href={category.url} class={active ? "is-active" : undefined} aria-current={active ? "page" : undefined}>
                  <span>{category.label}</span>
                  <span class="rail-count">{category.count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="rail-empty">{UI.noCategories}</p>
      )}
    </section>

    {profile.links.length > 0 && (
      <section class="rail-section" aria-labelledby="rail-links-title">
        <h2 id="rail-links-title" class="rail-section-title">{profile.linksTitle}</h2>
        <ul class="profile-link-list">
          {profile.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="profile-link-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M10 13a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 1 0-7.07-7.07l-1.22 1.22" />
                    <path d="M14 11a5 5 0 0 0-7.07 0l-2.12 2.12a5 5 0 1 0 7.07 7.07l1.22-1.22" />
                  </svg>
                </span>
                <span class="profile-link-copy">
                  <strong>{link.label}</strong>
                  <em>{link.note}</em>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="rail-prefs">
      <div class="theme-switch" role="group" aria-label={UI.themeToggle}>
        <button type="button" data-theme-set="light" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
          라이트
        </button>
        <button type="button" data-theme-set="dark" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
          다크
        </button>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-rail-search]");
    const input = root?.querySelector("[data-rail-search-input]");
    const results = root?.querySelector("[data-rail-search-results]");
    const index = root?.querySelector("[data-rail-search-index]");
    if (!root || !(input instanceof HTMLInputElement) || !results || !index) return;

    let items = [];
    try {
      const raw = index instanceof HTMLTemplateElement ? index.content.textContent : index.textContent;
      items = JSON.parse((raw || "[]").trim());
    } catch {
      items = [];
    }

    const close = () => {
      results.hidden = true;
      input.setAttribute("aria-expanded", "false");
    };

    const render = () => {
      const query = input.value.trim().toLocaleLowerCase("ko-KR");
      results.textContent = "";
      if (!query) {
        close();
        return;
      }
      const found = items
        .filter((item) => [item.title, item.summary, item.category, ...(item.tags || [])].join(" ").toLocaleLowerCase("ko-KR").includes(query))
        .slice(0, 6);
      if (found.length === 0) {
        const empty = document.createElement("p");
        empty.className = "rail-search__empty";
        empty.textContent = "검색 결과가 없습니다";
        results.append(empty);
      } else {
        for (const item of found) {
          const link = document.createElement("a");
          link.href = item.url;
          const title = document.createElement("strong");
          title.textContent = item.title;
          const meta = document.createElement("span");
          meta.textContent = item.category || "글";
          link.append(title, meta);
          results.append(link);
        }
      }
      results.hidden = false;
      input.setAttribute("aria-expanded", "true");
    };

    input.setAttribute("aria-expanded", "false");
    input.addEventListener("input", render);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !results.hidden) {
        event.preventDefault();
        event.stopPropagation();
        close();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) close();
    });
  })();
</script>
