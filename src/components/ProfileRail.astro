---
import { SITE, UI } from "../config";
import { getGithubProfile } from "../lib/site-data";
import { getCategories, categoryUrl } from "../lib/posts";
import { getCollection } from "astro:content";

const gh = getGithubProfile();
const pages = await getCollection("pages", (page) => !page.data.draft);
const findPage = (slug: string) => pages.find((page) => page.data.slug === slug);
const profilePage = findPage("profile");
const linksPage = findPage("links");
const categories = await getCategories();
const path = decodeURI(Astro.url.pathname);
const profileName = profilePage?.data.profile_name || gh.name;
const profileHandle = profilePage?.data.profile_handle || SITE.handle;
const profileAddress = profilePage?.data.profile_address || SITE.location;
const profileAvatar = profilePage?.data.profile_avatar || gh.avatar_url;
const profileUrl = profilePage?.data.profile_url || gh.html_url;
const profileIntroTitle = profilePage?.data.title || "World Calling";
const profileBio = profilePage?.data.summary || gh.bio;
const notionLinks = linksPage?.data.links || [];
const fallbackLinks = [
  { label: "Portfolio", href: SITE.portfolio },
  { label: "GitHub", href: gh.html_url },
];
const profileLinks = (notionLinks.length > 0 ? notionLinks : fallbackLinks).filter((link) => link.href);
const hostnameFor = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return href;
  }
};
---

<aside id="profile-rail" class="profile-rail" aria-label="Profile and categories" data-drag-rail="left">
  <section class="profile-section profile-section--identity" aria-label="프로필">
    <p class="profile-kicker">프로필</p>
    <div class="profile-intro">
      <a class="avatar" href={profileUrl} target="_blank" rel="noopener noreferrer" aria-label={`${profileName} profile`}>
        <img src={profileAvatar} alt={profileName} width="56" height="56" loading="lazy" decoding="async" />
      </a>
      <div class="profile-block">
        <p class="profile-handle">@{profileHandle}</p>
        <a class="brand" href="/">{SITE.title}</a>
        {profileName && <p class="profile-name">{profileName}</p>}
      </div>
    </div>
  </section>

  <section class="profile-section" aria-label="World Calling 소개글과 주소">
    <p class="rail-section-title">{profileIntroTitle}</p>
    {profileBio && <p class="profile-bio">{profileBio}</p>}
    <div class="profile-address-block">
      <p class="profile-address-label">주소</p>
      <address class="profile-address" aria-label="주소">
        <span>{profileAddress}</span>
      </address>
    </div>
  </section>

  <section class="profile-section" aria-label={UI.categories}>
    <p class="rail-section-title">{UI.categories}</p>
    <nav class="rail-category-list">
      {categories.length > 0 ? (
        categories.map((c) => {
          const href = categoryUrl(c.name);
          const active = path === href;
          return (
            <a href={href} class={active ? "is-active" : ""} aria-current={active ? "page" : undefined}>
              <span>{c.name} ({c.count})</span>
            </a>
          );
        })
      ) : (
        <span class="rail-empty">{UI.noCategories}</span>
      )}
    </nav>
  </section>

  <section class="profile-section" aria-label="링크">
    <p class="rail-section-title">{linksPage?.data.title || "Links"}</p>
    <nav class="profile-link-list">
      {profileLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          <span class="profile-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M10 13a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 1 0-7.07-7.07l-1.22 1.22" />
              <path d="M14 11a5 5 0 0 0-7.07 0l-2.12 2.12a5 5 0 1 0 7.07 7.07l1.22-1.22" />
            </svg>
          </span>
          <span class="profile-link-copy">
            <strong>{link.label}</strong>
            <em>{link.note || hostnameFor(link.href)}</em>
          </span>
        </a>
      ))}
    </nav>
  </section>
</aside>
