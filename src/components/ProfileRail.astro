---
import { SITE, UI } from "../config";
import { getGithubProfile } from "../lib/site-data";
import { getCategories, categoryUrl } from "../lib/posts";

const gh = getGithubProfile();
const categories = await getCategories();
const path = decodeURI(Astro.url.pathname);
const profileLinks = [
  { label: "Portfolio", href: SITE.portfolio },
  { label: "GitHub", href: gh.html_url },
].filter((link) => link.href);
const hostnameFor = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return href;
  }
};
const faviconFor = (href: string) => {
  const host = hostnameFor(href);
  return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=32`;
};
---

<aside class="profile-rail" aria-label="Profile and categories">
  <section class="profile-section profile-section--identity" aria-label="프로필">
    <p class="profile-kicker">프로필</p>
    <div class="profile-intro">
      <a class="avatar" href={gh.html_url} target="_blank" rel="noopener noreferrer" aria-label={`${gh.name} GitHub`}>
        <img src={gh.avatar_url} alt={gh.name} width="56" height="56" loading="lazy" decoding="async" />
      </a>
      <div class="profile-block">
        <p class="profile-handle">@{SITE.handle}</p>
        <a class="brand" href="/">{SITE.title}</a>
        {gh.name && <p class="profile-name">{gh.name}</p>}
      </div>
    </div>
  </section>

  <section class="profile-section" aria-label="World Calling 소개글과 주소">
    <p class="rail-section-title">World Calling</p>
    {gh.bio && <p class="profile-bio">{gh.bio}</p>}
    <div class="profile-address-block">
      <p class="profile-address-label">주소</p>
      <address class="profile-address" aria-label="주소">
        <span>{SITE.location}</span>
      </address>
    </div>
  </section>

  <section class="profile-section" aria-label="링크">
    <p class="rail-section-title">Links</p>
    <nav class="profile-link-list">
      {profileLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          <img
            class="profile-link-favicon"
            src={faviconFor(link.href)}
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
          />
          <span class="profile-link-copy">
            <strong>{link.label}</strong>
            <em>{hostnameFor(link.href)}</em>
          </span>
        </a>
      ))}
    </nav>
  </section>

  <section class="profile-section" aria-label={UI.categories}>
    <p class="rail-section-title">{UI.categories}</p>
    <nav class="rail-category-list">
      {categories.length > 0 ? (
        categories.map((c) => {
          const href = categoryUrl(c.name);
          const active = path === href;
          return (
            <a href={href} class={active ? "is-active" : ""} aria-current={active ? "page" : undefined}>
              <span>{c.name}</span>
              <strong>{c.count}</strong>
            </a>
          );
        })
      ) : (
        <span class="rail-empty">{UI.noCategories}</span>
      )}
    </nav>
  </section>
</aside>
