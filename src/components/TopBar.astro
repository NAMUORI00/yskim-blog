---
import { SITE, UI } from "../config";
const path = Astro.url.pathname;
const isHome = path === "/";
const nav = [
  { name: UI.navPosts, href: "/posts/" },
  { name: UI.navAbout, href: "/pages/about/" },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="top-bar">
  <div class="top-bar-inner">
    <a class="top-bar-brand" href="/">{SITE.title}</a>
    <nav class="top-bar-nav" aria-label="Main navigation">
      <a href="/" class={isHome ? "is-active" : ""} aria-current={isHome ? "page" : undefined}>
        {UI.navHome}
      </a>
      {nav.map((item) => (
        <a
          href={item.href}
          class={isActive(item.href) ? "is-active" : ""}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <a class="top-bar-external" href={SITE.portfolio} target="_blank" rel="noopener noreferrer">
        {UI.navPortfolio} ↗
      </a>
    </nav>
    <div class="top-bar-utils">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-light-label="라이트"
        data-dark-label="다크"
        aria-label={UI.themeToggle}
        aria-pressed="false"
        title="다크"
      >
        <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
