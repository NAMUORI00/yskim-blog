---
import { SITE, UI } from "../config";
const path = Astro.url.pathname;
const isHome = path === "/";
// 소개는 홈에 통합되어 별도 메뉴를 두지 않는다.
const nav = [
  { name: UI.navPosts, href: "/posts/" },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="top-bar">
  <div class="top-bar-inner">
    <a class="top-bar-brand" href="/">{SITE.title}</a>
    <nav id="primary-nav" class="top-bar-nav" aria-label="Main navigation">
      <a href="/" class={isHome ? "is-active" : ""} aria-current={isHome ? "page" : undefined}>
        {UI.navHome}
      </a>
      {nav.map((item) => (
        <a
          href={item.href}
          class={isActive(item.href) ? "is-active" : ""}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <a class="top-bar-external" href={SITE.portfolio} target="_blank" rel="noopener noreferrer">
        {UI.navPortfolio} ↗
      </a>
    </nav>
    <div class="top-bar-utils">
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="메뉴 열기"
      >
        <span class="nav-toggle-box" aria-hidden="true">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </span>
      </button>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-light-label="라이트"
        data-dark-label="다크"
        aria-label={UI.themeToggle}
        aria-pressed="false"
        title="다크"
      >
        <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-nav-toggle]");
    const nav = document.getElementById("primary-nav");
    if (!toggle || !nav) return;

    const QUERY = "(max-width: 720px)";
    const mq = window.matchMedia(QUERY);

    const setOpen = (open) => {
      nav.classList.toggle("is-open", open);
      document.body.classList.toggle("nav-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!nav.classList.contains("is-open"));
    });

    // Close after navigating from the menu.
    nav.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) setOpen(false);
    });

    // Close on Escape.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close when clicking outside the menu.
    document.addEventListener("click", (e) => {
      if (!nav.classList.contains("is-open")) return;
      const t = e.target;
      if (t instanceof Node && !nav.contains(t) && t !== toggle && !toggle.contains(t)) {
        setOpen(false);
      }
    });

    // Reset state when leaving the mobile breakpoint.
    const onChange = () => {
      if (!mq.matches) setOpen(false);
    };
    if (mq.addEventListener) mq.addEventListener("change", onChange);
    else mq.addListener(onChange);
  })();
</script>
