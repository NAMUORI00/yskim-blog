---
import { SITE, UI, ASSET_VERSION } from "../config";
import { getCollection } from "astro:content";
import Seo from "../components/Seo.astro";
import TopBar from "../components/TopBar.astro";
import ProfileRail from "../components/ProfileRail.astro";
import Sidebar from "../components/Sidebar.astro";
import BackToTop from "../components/BackToTop.svelte";
import "../styles/enhance.css";

export interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  canonical?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  isHome?: boolean;
  breadcrumb?: { name: string; item: string }[];
  math?: boolean;
}

const { math = false, ...seo } = Astro.props;
const rss = new URL("/index.xml", SITE.url).href;
const githubUrl = `https://github.com/${SITE.github}`;
const pages = await getCollection("pages", (page) => !page.data.draft);
const findPage = (slug: string) => pages.find((page) => page.data.slug === slug);
const footerPageSlugs = ["privacy", "disclaimer", "contact"];
const footerPages = footerPageSlugs
  .map((slug) => {
    const page = findPage(slug);
    if (!page) return null;
    return {
      href: `/pages/${slug}/`,
      label: page.data.footer_label || page.data.title,
    };
  })
  .filter((page): page is { href: string; label: string } => Boolean(page));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css"
      />
    </noscript>
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Serif+KR:wght@500;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Serif+KR:wght@500;600;700&display=swap"
      />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("yskim-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          const theme = saved === "light" || saved === "dark" ? saved : preferred;
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add("theme-" + theme);
        } catch {
          document.documentElement.dataset.theme = "light";
          document.documentElement.classList.add("theme-light");
        }
      })();
    </script>
    <link rel="stylesheet" href={`/css/site.css?v=${ASSET_VERSION}`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rss} />
    <Seo {...seo} />
    {math && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
        integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
        crossorigin="anonymous"
      />
    )}
    <script src={`/js/theme.js?v=${ASSET_VERSION}`} defer></script>
    <script src={`/js/window-controls.js?v=${ASSET_VERSION}`} defer></script>
    <script src={`/js/embeds.js?v=${ASSET_VERSION}`} defer></script>
    {SITE.adsensePublisherId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisherId}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <script is:inline>
      (() => {
        const theme = document.documentElement.dataset.theme || "light";
        document.body.classList.add("theme-" + theme);
      })();
    </script>
    <TopBar />
    <div class="rail-dock-layer" aria-label="접힌 사이드바">
      <button
        class="rail-dock rail-dock--left"
        type="button"
        data-drag-rail-toggle="left"
        aria-controls="profile-rail"
        aria-expanded="false"
      >
        Profile
      </button>
      <button
        class="rail-dock rail-dock--right"
        type="button"
        data-drag-rail-toggle="right"
        aria-controls="blog-sidebar"
        aria-expanded="false"
      >
        Graph
      </button>
    </div>
    <div class="site-shell">
      <ProfileRail />
      <div class="content-column">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <div class="site-footer__inner">
            <span class="site-footer__license">{UI.footerCopyright}</span>
            <nav class="footer-primary" aria-label="프로젝트 링크">
              <a href={SITE.portfolio} target="_blank" rel="noopener noreferrer">{UI.navPortfolio}</a>
              <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href="/index.xml">RSS</a>
              {SITE.notionPublicUrl && (
                <a href={SITE.notionPublicUrl} target="_blank" rel="noopener noreferrer">Notion</a>
              )}
            </nav>
            {footerPages.length > 0 && (
              <nav class="footer-legal" aria-label="사이트 정보">
                {footerPages.map((page) => <a href={page.href}>{page.label}</a>)}
              </nav>
            )}
          </div>
        </footer>
      </div>
      <Sidebar />
    </div>
    <BackToTop client:idle />
  </body>
</html>
