---
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/ArchiveView.astro";
import { categoryFacets, getTaxonomy, listItems } from "../../lib/posts";
import { paginate } from "../../lib/taxonomy.mjs";

export async function getStaticPaths() {
  const taxonomy = await getTaxonomy();
  return taxonomy.categories
    .filter((category) => category.url)
    .map((category) => ({ params: { category: category.slug }, props: { id: category.id } }));
}

const { id } = Astro.props;
const taxonomy = await getTaxonomy();
const category = taxonomy.categoryById.get(id)!;
const pages = paginate(category.posts.map((slug) => taxonomy.bySlug.get(slug)!));
---

<Base title={category.label} description={`카테고리: ${category.label}`}>
  <ArchiveView
    kicker="Category"
    title={category.label}
    total={category.count}
    posts={listItems(taxonomy, pages[0])}
    base={category.url!}
    page={1}
    pages={pages.length}
    facets={categoryFacets(taxonomy, category.id)}
  />
</Base>
