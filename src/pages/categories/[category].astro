---
import Base from "../../layouts/Base.astro";
import PostListWindow from "../../components/PostListWindow.astro";
import { getPublishedPosts, slugifyTerm, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const map = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const category of post.data.categories) {
      const slug = slugifyTerm(category);
      if (!map.has(slug)) map.set(slug, { name: category, posts: [] });
      map.get(slug)!.posts.push(post);
    }
  }
  return [...map.entries()].map(([category, { name, posts: list }]) => ({
    params: { category },
    props: { name, posts: list },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name} description={`카테고리: ${name}`}>
  <PostListWindow label="카테고리" title={name} posts={posts} />
</Base>
