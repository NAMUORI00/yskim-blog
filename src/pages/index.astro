---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE, UI } from "../config";
import { getCollection, render } from "astro:content";
import { getPublishedPosts, postUrl } from "../lib/posts";
import { getGithubProfile } from "../lib/site-data";

const gh = getGithubProfile();
const posts = (await getPublishedPosts()).slice(0, 5);

// 홈 = 홈 + 소개. about 페이지 본문을 랜딩에 그대로 합쳐서 보여준다.
const pages = await getCollection("pages", (p) => !p.data.draft);
const about = pages.find((p) => p.data.slug === "about");
const AboutContent = about ? (await render(about)).Content : null;
---

<Base isHome={true} title={SITE.title} description={SITE.description} type="website">
  <article class="readme-card post home-readme">
    <div class="filebar">
      <span></span><span></span><span></span>
      <strong>README.md</strong>
      <em>{SITE.handle}</em>
    </div>
    <div class="post-inner">
      <header class="post-header">
        <h1>{SITE.title}</h1>
        <p class="summary">{SITE.description}</p>
        {gh.bio && <p class="profile-bio profile-bio--about">{gh.bio}</p>}
        <div class="hero-actions">
          <a class="primary-link" href="/posts/">{UI.allPosts}</a>
          <a class="text-link" href={SITE.portfolio} target="_blank" rel="noopener noreferrer">
            {UI.navPortfolio} ↗
          </a>
        </div>
      </header>
      {AboutContent && (
        <div class="content">
          <AboutContent />
        </div>
      )}
    </div>
  </article>

  {posts.length > 0 && (
    <section class="post-feed post-feed--home">
      <div class="section-heading">
        <h2>{UI.recent}</h2>
        <a class="section-link" href="/posts/">{UI.allPosts}</a>
      </div>
      <div class="post-list">
        {posts.map((p) => (
          <PostCard
            href={postUrl(p.data.slug)}
            title={p.data.title}
            date={p.data.date}
            category={p.data.categories[0]}
            summary={p.data.summary}
            cover={p.data.cover || undefined}
            tags={p.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</Base>
