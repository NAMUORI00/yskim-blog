---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE, UI } from "../config";
import { getPublishedPosts, postUrl } from "../lib/posts";

const posts = (await getPublishedPosts()).slice(0, 10);
---

<Base isHome={true}>
  <section class="post-feed post-feed--home">
    <div class="section-heading section-heading--home">
      <h1>{SITE.title}</h1>
      <a class="section-link" href="/posts/">{UI.allPosts}</a>
    </div>
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((p) => (
          <PostCard
            href={postUrl(p.data.slug)}
            title={p.data.title}
            date={p.data.date}
            category={p.data.categories[0]}
            summary={p.data.summary}
            cover={p.data.cover || undefined}
            tags={p.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{UI.noPostsYet}</p>
    )}
  </section>
</Base>
