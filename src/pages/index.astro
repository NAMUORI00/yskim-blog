---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { SITE, UI } from "../config";
import { getCollection, render } from "astro:content";
import { getTaxonomy, listItems } from "../lib/posts";
import { categoryTags } from "../lib/taxonomy.mjs";

// The intro is the only home content managed by hand (Notion `home` page);
// the sections below are derived from the published posts.
const pages = await getCollection("pages", (p) => !p.data.draft);
const findPage = (slug: string) => pages.find((p) => p.data.slug === slug);
const homePage = findPage("home");
const HomeContent = homePage ? (await render(homePage)).Content : null;
const heroTitle = homePage?.data.title || SITE.title;
const heroSummary = homePage?.data.summary || SITE.description;

const taxonomy = await getTaxonomy();
const recent = listItems(taxonomy, taxonomy.posts.slice(0, 5));
const categories = taxonomy.categories.map((category) => ({
  ...category,
  latestDay: category.latest ? category.latest.toISOString().slice(0, 10) : "",
  topics: categoryTags(taxonomy, category.id).slice(0, 5),
}));
---

<Base isHome={true} title={heroTitle} description={heroSummary} type="website">
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">NAMUORI.LOG</p>
    <h1 id="home-title">{heroTitle}</h1>
    {heroSummary && <p class="home-intro__lead">{heroSummary}</p>}
    {HomeContent && (
      <div class="home-intro__note content">
        <HomeContent />
      </div>
    )}
    <div class="hero-actions">
      <a class="primary-link" href="/posts/">{UI.allPosts}</a>
      <a class="text-link" href={SITE.portfolio} target="_blank" rel="noopener noreferrer">{UI.navPortfolio} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-recent">
    <SectionTitle id="home-recent" title={UI.recent} link={recent.length ? { href: "/posts/", label: UI.allPosts } : undefined} />
    <PostList posts={recent} level={3} />
  </section>

  {categories.length > 0 && (
    <section class="home-section" aria-labelledby="home-categories">
      <SectionTitle id="home-categories" title={UI.categories} />
      <ul class="category-overview">
        {categories.map((category) => (
          <li class="category-row">
            <div class="category-row__head">
              {category.url ? (
                <a class="category-row__name" href={category.url}>{category.label}</a>
              ) : (
                <span class="category-row__name">{category.label}</span>
              )}
              <span class="category-row__meta">글 {category.count}{category.latestDay && <> · 최근 <time datetime={category.latestDay}>{category.latestDay}</time></>}</span>
            </div>
            {category.topics.length > 0 && (
              <ul class="tags category-row__topics" aria-label={`${category.label}의 주제`}>
                {category.topics.map(({ tag }) => <li><a href={tag.url}>#{tag.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
