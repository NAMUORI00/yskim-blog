---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE, UI } from "../config";
import { getCollection, render } from "astro:content";
import { getCategories, getPublishedPosts, postUrl } from "../lib/posts";
import { getGithubProfile } from "../lib/site-data";

const gh = getGithubProfile();
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 5);
const categories = await getCategories();

const pages = await getCollection("pages", (p) => !p.data.draft);
const findPage = (slug: string) => pages.find((p) => p.data.slug === slug);
const homePage = findPage("home");
const readmePage = findPage("readme") ?? findPage("about");
const HomeContent = homePage ? (await render(homePage)).Content : null;
const ReadmeContent = readmePage ? (await render(readmePage)).Content : null;
const heroTitle = homePage?.data.title || SITE.title;
const heroSummary = homePage?.data.summary || SITE.description;
const latestPostDate = allPosts[0]?.data.date.toISOString().slice(0, 10) ?? "ready";
const readmeSource = readmePage?.data.generated_by === "notion" ? "Notion DB" : "Repository";
---

<Base isHome={true} title={heroTitle} description={heroSummary} type="website">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow">NAMUORI.LOG</p>
      <h1 id="home-title">{heroTitle}</h1>
      <p class="summary">{heroSummary}</p>
      {gh.bio && <p class="profile-bio profile-bio--about">{gh.bio}</p>}
      {HomeContent && (
        <div class="home-hero__note content">
          <HomeContent />
        </div>
      )}
      <dl class="home-hero__metrics" aria-label="블로그 현황">
        <div>
          <dt>Notes</dt>
          <dd>{allPosts.length}</dd>
        </div>
        <div>
          <dt>Categories</dt>
          <dd>{categories.length}</dd>
        </div>
        <div>
          <dt>Latest</dt>
          <dd>{latestPostDate}</dd>
        </div>
      </dl>
      <div class="hero-actions">
        <a class="primary-link" href="/posts/">{UI.allPosts}</a>
        <a class="text-link" href={SITE.portfolio} target="_blank" rel="noopener noreferrer">
          {UI.navPortfolio} ↗
        </a>
      </div>
    </div>
    <div class="home-hero__signal" aria-hidden="true">
      <span class="signal-orbit signal-orbit--one"></span>
      <span class="signal-orbit signal-orbit--two"></span>
      <span class="signal-node signal-node--root"></span>
      <span class="signal-node signal-node--post"></span>
      <span class="signal-node signal-node--tag"></span>
    </div>
  </section>

  {ReadmeContent && readmePage && (
    <article class="readme-card post home-readme" aria-labelledby="home-readme-title" data-content-window>
      <div class="filebar">
        <div class="filebar-controls" aria-label="콘텐츠 창 제어">
          <button type="button" class="filebar-control filebar-control--close" data-window-action="close" aria-label="닫기"></button>
          <button type="button" class="filebar-control filebar-control--minimize" data-window-action="minimize" aria-label="최소화"></button>
          <button type="button" class="filebar-control filebar-control--maximize" data-window-action="maximize" aria-label="최대화"></button>
        </div>
        <strong>{readmePage.data.slug}.md</strong>
        <em>{SITE.handle}</em>
      </div>
      <header class="home-readme__header">
        <div>
          <p class="eyebrow">Notion README</p>
          <h2 id="home-readme-title">{readmePage.data.title}</h2>
          {readmePage.data.summary && <p class="summary">{readmePage.data.summary}</p>}
        </div>
        <dl class="home-readme__meta" aria-label="README source">
          <div>
            <dt>Source</dt>
            <dd>{readmeSource}</dd>
          </div>
          <div>
            <dt>Slug</dt>
            <dd>{readmePage.data.slug}</dd>
          </div>
        </dl>
      </header>
      <div class="post-inner home-readme__inner">
        <div class="content home-readme__content">
          <ReadmeContent />
        </div>
      </div>
    </article>
  )}

  {posts.length > 0 && (
    <section class="post-feed post-feed--home">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Recent Notes</p>
          <h2>{UI.recent}</h2>
        </div>
        <a class="section-link" href="/posts/">{UI.allPosts}</a>
      </div>
      <div class="post-list">
        {posts.map((p) => (
          <PostCard
            href={postUrl(p.data.slug)}
            title={p.data.title}
            date={p.data.date}
            category={p.data.categories[0]}
            summary={p.data.summary}
            cover={p.data.cover || undefined}
            tags={p.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</Base>
