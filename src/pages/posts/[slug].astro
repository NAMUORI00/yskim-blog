---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ReadingProgress from "../../components/ReadingProgress.svelte";
import Comments from "../../components/Comments.astro";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import { SITE } from "../../config";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = d.date.toISOString().slice(0, 10);
const isAffiliate = d.tags.some((t) => ["affiliate", "제휴"].includes(t.toLowerCase()));
const breadcrumb = [
  { name: "홈", item: SITE.url + "/" },
  { name: "글", item: SITE.url + "/posts/" },
  { name: d.title, item: new URL(`/posts/${d.slug}/`, SITE.url).href },
];
---

<Base
  title={d.title}
  description={d.summary}
  type="article"
  image={d.cover || undefined}
  canonical={d.canonical || undefined}
  publishedTime={d.date}
  modifiedTime={d.date}
  tags={d.tags}
  breadcrumb={breadcrumb}
  math={d.math}
>
  <ReadingProgress client:idle />
  <article class="readme-card post" data-content-window>
    <div class="filebar">
      <div class="filebar-controls" aria-label="콘텐츠 창 제어">
        <button type="button" class="filebar-control filebar-control--move" data-window-action="move" aria-label="창 이동" aria-pressed="false"></button>
        <button type="button" class="filebar-control filebar-control--close" data-window-action="close" aria-label="닫기"></button>
        <button type="button" class="filebar-control filebar-control--minimize" data-window-action="minimize" aria-label="최소화"></button>
        <button type="button" class="filebar-control filebar-control--maximize" data-window-action="maximize" aria-label="최대화"></button>
      </div>
      <strong>posts/{d.slug}.md</strong>
    </div>
    <div class="post-inner">
      <header class="post-header">
        <p class="eyebrow">{dateStr}</p>
        <h1>{d.title}</h1>
        {d.summary && <p class="summary">{d.summary}</p>}
        {d.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {d.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </header>
      <div class="content">
        {isAffiliate && <AffiliateDisclosure />}
        <Content />
      </div>
      {d.comments && <Comments />}
    </div>
  </article>
</Base>
