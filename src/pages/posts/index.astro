---
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/ArchiveView.astro";
import { UI } from "../../config";
import { archiveFacets, getTaxonomy, listItems } from "../../lib/posts";
import { paginate } from "../../lib/taxonomy.mjs";

const taxonomy = await getTaxonomy();
const pages = paginate(taxonomy.posts);
---

<Base title={UI.allPosts} description="공개 발행된 노트와 글.">
  <ArchiveView
    kicker="Archive"
    title={UI.allPosts}
    total={taxonomy.posts.length}
    posts={listItems(taxonomy, pages[0])}
    base="/posts/"
    page={1}
    pages={pages.length}
    facets={archiveFacets(taxonomy)}
  />
</Base>
