---
import Base from "../../layouts/Base.astro";
import PostListWindow from "../../components/PostListWindow.astro";
import { UI } from "../../config";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<Base title={UI.allPosts} description="공개 발행된 노트와 글.">
  <PostListWindow label="아카이브" title={UI.allPosts} posts={posts} />
</Base>
