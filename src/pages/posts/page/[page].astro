---
import Base from "../../../layouts/Base.astro";
import ArchiveView from "../../../components/ArchiveView.astro";
import { UI } from "../../../config";
import { archiveFacets, getTaxonomy, listItems } from "../../../lib/posts";
import { paginate } from "../../../lib/taxonomy.mjs";

export async function getStaticPaths() {
  const taxonomy = await getTaxonomy();
  const pages = paginate(taxonomy.posts);
  return pages.slice(1).map((posts, index) => ({ params: { page: String(index + 2) }, props: { posts, page: index + 2, pages: pages.length } }));
}

const { posts, page, pages } = Astro.props;
const taxonomy = await getTaxonomy();
---

<Base title={`${UI.allPosts} (${page}페이지)`} description="공개 발행된 노트와 글.">
  <ArchiveView
    kicker="Archive"
    title={UI.allPosts}
    total={taxonomy.posts.length}
    posts={listItems(taxonomy, posts)}
    base="/posts/"
    page={page}
    pages={pages}
    facets={archiveFacets(taxonomy)}
  />
</Base>
