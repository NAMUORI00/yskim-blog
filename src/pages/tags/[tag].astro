---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts, postUrl, slugifyTerm, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const map = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTerm(tag);
      if (!map.has(slug)) map.set(slug, { name: tag, posts: [] });
      map.get(slug)!.posts.push(post);
    }
  }
  return [...map.entries()].map(([tag, { name, posts: list }]) => ({
    params: { tag },
    props: { name, posts: list },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`태그: ${name}`}>
  <header class="page-heading archive-heading">
    <p class="eyebrow">Tag</p>
    <h1>#{name}</h1>
    <p>태그 · {posts.length}개의 글</p>
  </header>
  <section class="post-feed">
    <div class="post-list">
      {posts.map((p) => (
        <PostCard
          href={postUrl(p.data.slug)}
          title={p.data.title}
          date={p.data.date}
          category={p.data.categories[0]}
          summary={p.data.summary}
          cover={p.data.cover || undefined}
          tags={p.data.tags}
        />
      ))}
    </div>
  </section>
</Base>
