---
import Base from "../../layouts/Base.astro";
import PostListWindow from "../../components/PostListWindow.astro";
import { getPublishedPosts, slugifyTerm, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const map = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTerm(tag);
      if (!map.has(slug)) map.set(slug, { name: tag, posts: [] });
      map.get(slug)!.posts.push(post);
    }
  }
  return [...map.entries()].map(([tag, { name, posts: list }]) => ({
    params: { tag },
    props: { name, posts: list },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`태그: ${name}`}>
  <PostListWindow label="태그" title={name} posts={posts} />
</Base>
