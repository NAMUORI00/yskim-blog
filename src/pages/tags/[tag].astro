---
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/ArchiveView.astro";
import { getTaxonomy, listItems, tagFacets } from "../../lib/posts";
import { paginate } from "../../lib/taxonomy.mjs";

export async function getStaticPaths() {
  const taxonomy = await getTaxonomy();
  return taxonomy.tags.map((tag) => ({ params: { tag: tag.slug }, props: { id: tag.id } }));
}

const { id } = Astro.props;
const taxonomy = await getTaxonomy();
const tag = taxonomy.tagById.get(id)!;
const pages = paginate(tag.posts.map((slug) => taxonomy.bySlug.get(slug)!));
---

<Base title={`#${tag.label}`} description={`태그: ${tag.label}`}>
  <ArchiveView
    kicker="Topic"
    title={`#${tag.label}`}
    total={tag.count}
    posts={listItems(taxonomy, pages[0])}
    base={tag.url}
    page={1}
    pages={pages.length}
    facets={tagFacets(taxonomy, tag.id)}
  />
</Base>
